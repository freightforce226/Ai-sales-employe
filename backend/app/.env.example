DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
MS_CLIENT_ID=your_client_id
MS_CLIENT_SECRET=your_client_secret
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback
MS_SCOPES=offline_access Mail.Send Mail.Read User.Read
TOKEN_ENCRYPTION_KEY=your_fernet_key_here
N8N_SERVICE_API_KEY=your_n8n_api_key
OAUTH_STATE_SECRET=your_oauth_state_secret
ENVIRONMENT=development
LOG_LEVEL=DEBUG
APP_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here

AI_REPLY_RECOVERY_INTERVAL_MINUTES=5
AI_REPLY_LOCK_TIMEOUT_MINUTES=15





